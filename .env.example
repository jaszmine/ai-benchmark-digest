# Model & Provider Setup (OpenRouter)
OPENROUTER_API_KEY="sk-or-v1-..."
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
MODEL_NAME="nvidia/nemotron-3-super-120b-a12b:free"
APP_REFERER="https://github.com/username/ai-benchmark-digest"
APP_TITLE="AI Benchmark Digest"

# Web Search Tooling (Track B)
TAVILY_API_KEY="tvly-..."

# Email Dispatch
RESEND_API_KEY="re_..."
NOTIFICATION_EMAIL_TO="recipient@example.com"
NOTIFICATION_EMAIL_FROM="benchmark@urdomain.com" 

# Pipeline Calibration
LOOKBACK_DAYS=7
MAX_TRACK_B_TURNS=3
INTER_TURN_SLEEP_SECONDS=3.0
INTER_TRACK_PAUSE_SECONDS=15.0
