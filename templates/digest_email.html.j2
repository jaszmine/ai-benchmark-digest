<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ digest_title }}</title>
  <style>
    body {
      margin: 0;
      padding: 20px;
      background-color: #0d1117;
      color: #c9d1d9;
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;
    }
    .container {
      max-width: 900px;
      margin: 0 auto;
    }
    .header {
      border-bottom: 1px solid #30363d;
      padding-bottom: 16px;
      margin-bottom: 24px;
    }
    h1 {
      color: #58a6ff;
      font-size: 24px;
      margin: 0 0 6px 0;
    }
    .meta {
      color: #8b949e;
      font-size: 13px;
    }
    .card {
      background-color: #161b22;
      border: 1px solid #30363d;
      border-radius: 8px;
      padding: 20px;
      margin-bottom: 24px;
    }
    .card-title {
      font-size: 16px;
      font-weight: 600;
      margin-bottom: 14px;
      color: #f0f6fc;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .table-bench {
      width: 100%;
      border-collapse: collapse;
      font-size: 13px;
    }
    .table-bench th, .table-bench td {
      padding: 8px 12px;
      text-align: left;
      border-bottom: 1px solid #21262d;
    }
    .table-bench th {
      color: #8b949e;
      font-weight: 500;
    }
    .story-item {
      padding: 12px 0;
      border-bottom: 1px solid #21262d;
    }
    .story-item:last-child {
      border-bottom: none;
    }
    .story-title {
      font-size: 15px;
      font-weight: 600;
      color: #58a6ff;
      text-decoration: none;
    }
    .story-title:hover {
      text-decoration: underline;
    }
    .story-meta {
      font-size: 12px;
      color: #8b949e;
      margin: 4px 0 6px 0;
    }
    .badge {
      display: inline-block;
      padding: 2px 6px;
      font-size: 11px;
      font-weight: 500;
      border-radius: 4px;
      background-color: #21262d;
      color: #79c0ff;
      border: 1px solid #388bfd;
      margin-right: 6px;
    }
    .story-summary {
      font-size: 13px;
      color: #c9d1d9;
      line-height: 1.45;
    }
    .deep-dive {
      background-color: #0d1117;
      border-left: 3px solid #8957e5;
      padding: 12px 16px;
      margin-top: 14px;
      border-radius: 0 6px 6px 0;
    }
    .deep-dive-title {
      color: #d2a8ff;
      font-weight: 600;
      font-size: 14px;
      margin-bottom: 6px;
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <h1>{{ digest_title }}</h1>
      <div class="meta">Comparative Evaluation: Track A (Heuristic Pipeline) vs. Track B (Autonomous ReAct) &bull; {{ run_timestamp }}</div>
    </div>

    <!-- BENCHMARK SCORECARD -->
    <div class="card">
      <div class="card-title">Telemetry & Execution Scorecard</div>
      <table class="table-bench">
        <thead>
          <tr>
            <th>Telemetry Metric</th>
            <th>Track A: Deterministic Heuristic</th>
            <th>Track B: Autonomous ReAct</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>Wall Clock Latency</td>
            <td><strong>{{ telemetry_a.wall_time_seconds }}s</strong></td>
            <td><strong>{{ telemetry_b.wall_time_seconds }}s</strong></td>
          </tr>
          <tr>
            <td>Input / Prompt Tokens</td>
            <td>{{ "{:,}".format(telemetry_a.prompt_tokens) }}</td>
            <td>{{ "{:,}".format(telemetry_b.prompt_tokens) }}</td>
          </tr>
          <tr>
            <td>Reasoning (CoT) Tokens</td>
            <td>{{ "{:,}".format(telemetry_a.reasoning_tokens) }}</td>
            <td>{{ "{:,}".format(telemetry_b.reasoning_tokens) }}</td>
          </tr>
          <tr>
            <td>Completion Tokens</td>
            <td>{{ "{:,}".format(telemetry_a.completion_tokens) }}</td>
            <td>{{ "{:,}".format(telemetry_b.completion_tokens) }}</td>
          </tr>
          <tr>
            <td>Total Tokens Consumed</td>
            <td><strong>{{ "{:,}".format(telemetry_a.total_tokens) }}</strong></td>
            <td><strong>{{ "{:,}".format(telemetry_b.total_tokens) }}</strong></td>
          </tr>
          <tr>
            <td>Agentic Iterations / Turns</td>
            <td>1 (Deterministic batch)</td>
            <td><strong>{{ telemetry_b.turns }} turn(s)</strong></td>
          </tr>
        </tbody>
      </table>
    </div>

    <!-- TRACK A -->
    <div class="card">
      <div class="card-title" style="color: #58a6ff;">
        <span>Track A: Top Curated Stories (Heuristic Pipeline)</span>
      </div>
      {% for story in track_a.stories %}
      <div class="story-item">
        <div>
          <span class="badge">{{ story.category }}</span>
          <a href="{{ story.url }}" class="story-title" target="_blank">{{ story.title }}</a>
        </div>
        <div class="story-meta">
          Source: {{ story.source }}
          {% if story.published_date_str %}
            &bull; {{ story.published_date_str }}
          {% endif %}
          {% if "ArXiv" in story.source and story.upvotes %}
            &bull; <span style="color: #58a6ff; font-weight: 600;">▲ {{ story.upvotes }} HF upvotes</span>
          {% elif "Hacker News" in story.source and story.upvotes %}
            &bull; <span style="color: #ff9f43; font-weight: 600;">▲ {{ story.upvotes }} HN pts</span>
          {% elif "Normal Technology" in story.source and story.upvotes %}
            &bull; <span style="color: #ff4757; font-weight: 600;">❤ {{ story.upvotes }} likes</span>
          {% endif %}
        </div>
        <div class="story-summary">{{ story.technical_summary }}</div>
      </div>
      {% endfor %}
    </div>

    <!-- TRACK B -->
    <div class="card">
      <div class="card-title" style="color: #bc8cff;">
        <span>Track B: Top Curated Stories (Autonomous ReAct)</span>
      </div>
      {% for story in track_b.stories %}
      <div class="story-item">
        <div>
          <span class="badge" style="border-color: #bc8cff; color: #d2a8ff;">{{ story.category }}</span>
          <a href="{{ story.url }}" class="story-title" style="color: #bc8cff;" target="_blank">{{ story.title }}</a>
        </div>
        <div class="story-meta">
          Source: {{ story.source }}
          {% if story.published_date_str %}
            &bull; {{ story.published_date_str }}
          {% endif %}
        </div>
        <div class="story-summary">{{ story.technical_summary }}</div>
      </div>
      {% endfor %}

      {% if deep_dive %}
      <div class="deep-dive">
        <div class="deep-dive-title">Track B Deep-Dive Analysis: {{ deep_dive.title }}</div>
        <div style="font-size: 13px; line-height: 1.5; color: #c9d1d9;">{{ deep_dive.analysis }}</div>
      </div>
      {% endif %}
    </div>

  </div>
</body>
</html>